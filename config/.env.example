# 复制为 .env 并填写你的真实值。
# 本仓库为开源发布, 默认使用零依赖哈希向量, 无需任何 API Key 即可运行。
# 如需接入真实语义向量/大模型, 按需填写(留空则回退哈希向量)。

# [可选] DeepSeek API Key(若你的 AI 助手需要用它做语义分诊/增强)
DEEPSEEK_API_KEY=

# [可选] 记忆数据根目录: 指定记忆库存放盘符/目录(留空则用引擎所在目录)
DSH_MEMORY_ROOT=

# [可选] bge-m3 语义向量: 本地模型路径 或 HTTP 接入点(留空则用哈希向量)
DSH_MEMORY_BGE_MODEL=
DSH_MEMORY_BGE_ENDPOINT=
